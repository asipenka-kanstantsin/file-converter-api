# App
NODE_ENV=development
APP_PORT=3001
APP_CORS_ORIGINS=http://localhost:3000
APP_TRUST_PROXY=0
APP_JSON_BODY_LIMIT=1mb
APP_PUBLIC_URL=http://localhost:3001

# Auth
AUTH_COOKIE_SECURE=false
AUTH_JWT_ACCESS_SECRET=access-secret-not-for-production-32-chars-x
AUTH_JWT_REFRESH_SECRET=refresh-secret-not-for-production-32-chars
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_PEPPER=change-me-32-chars-minimum-xxxxxxxxxxxx

# E-mail confirmation (Notion: 6 digits, TTL 10 min, 5 attempts, resend >= 60 s)
CONFIRMATION_TTL_SECONDS=600
CONFIRMATION_MAX_ATTEMPTS=5
CONFIRMATION_RESEND_COOLDOWN_SECONDS=60

# Mail (Mailpit in dev; turboSMTP or any SMTP relay in prod: pro.turbo-smtp.com:587)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="File Converter <no-reply@file-converter.local>"

# Jobs (outbox dispatcher)
JOBS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Rate limiting (global default per IP / user)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
THROTTLE_MAIL_LIMIT=3
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_BLOCK_SECONDS=900
THROTTLE_CONFIRM_LIMIT=10
THROTTLE_CONVERT_LIMIT=30
THROTTLE_PROFILE_LIMIT=60
THROTTLE_UPLOAD_LIMIT=10

# Storage (12-storage): local disk or any S3 API (SeaweedFS from docker compose)
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=./var/storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=app-dev
S3_ACCESS_KEY_ID=s3-access-key
S3_SECRET_ACCESS_KEY=s3-secret-key
S3_FORCE_PATH_STYLE=true

# Conversions (decisions F2, F6)
CONVERSION_TIMEOUT_MS=30000
