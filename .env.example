# App
NODE_ENV=development
APP_PORT=3001
APP_CORS_ORIGINS=http://localhost:3000
APP_TRUST_PROXY=0
APP_JSON_BODY_LIMIT=1mb

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/app

# Rate limiting (global default per IP / user)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
