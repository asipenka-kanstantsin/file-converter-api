generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless relative imports resolve the same way in tsc, Jest and ts-node (CommonJS).
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  blocked
  pending_verification

  @@map("user_status")
}

model User {
  id           String      @id @default(uuid(7)) @db.Uuid
  email        String      @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash String      @map("password_hash")
  displayName  String?     @map("display_name") @db.VarChar(100)
  photoFileId  String?     @unique(map: "users_photo_file_id_key") @map("photo_file_id") @db.Uuid
  photo        File?       @relation("UserPhoto", fields: [photoFileId], references: [id], onDelete: SetNull, map: "users_photo_file_id_fkey")
  files        File[]      @relation("FileOwner")
  status       UserStatus
  tokenVersion Int         @default(0) @map("token_version")
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  challenges   Challenge[]
  roles        UserRole[]

  @@map("users")
}

// RBAC configuration (Notion "RBAC", decisions R1-R5), cached in memory by RbacService.
model Role {
  id          String     @id @default(uuid(7)) @db.Uuid
  name        String     @unique(map: "roles_name_key") @db.VarChar(50)
  description String?    @db.VarChar(500)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  grants      Grant[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique(map: "permissions_name_key") @db.VarChar(64)
  actions   String[] @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  grants    Grant[]

  @@map("permissions")
}

// Role -> permission -> actions; empty actions = every action of the permission.
model Grant {
  id           String     @id @default(uuid(7)) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, map: "grants_role_id_fkey")
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, map: "grants_permission_id_fkey")
  actions      String[]   @default([]) @db.VarChar(32)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([roleId, permissionId], map: "grants_role_id_permission_id_key")
  @@index([permissionId], map: "grants_permission_id_idx")
  @@map("grants")
}

// Roles assigned to a user explicitly; the implicit `user` role is never stored (R5).
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String   @map("role_id") @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, map: "user_roles_role_id_fkey")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, roleId], map: "user_roles_pkey")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

enum ChallengePurpose {
  registration
  login
  email_change

  @@map("challenge_purpose")
}

// One pending e-mail confirmation (decision A4): a hashed 6-digit code and a hashed magic-link
// token for the same action.
model Challenge {
  id           String           @id @default(uuid(7)) @db.Uuid
  purpose      ChallengePurpose
  userId       String           @map("user_id") @db.Uuid
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String           @map("code_hash") @db.Char(64)
  tokenHash    String           @unique(map: "challenges_token_hash_key") @map("token_hash") @db.Char(64)
  // users.token_version when a sign-in challenge was issued; a later bump voids it (A2).
  tokenVersion Int?             @map("token_version")
  // The address an email_change challenge confirms; the mail goes there.
  newEmail     String?          @map("new_email") @db.VarChar(254)
  attempts     Int              @default(0)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  lastSentAt   DateTime         @map("last_sent_at") @db.Timestamptz(3)
  consumedAt   DateTime?        @map("consumed_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose], map: "challenges_user_id_purpose_idx")
  @@map("challenges")
}

// Runtime settings an admin can change without a deploy (decisions A6, F1).
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

enum OutboxStatus {
  pending
  processing
  done
  dead

  @@map("outbox_status")
}

// Transactional outbox (20-jobs): side effects written with the business change, delivered after.
model OutboxMessage {
  id             String       @id @default(uuid(7)) @db.Uuid
  type           String       @db.VarChar(100)
  payload        Json
  idempotencyKey String?      @unique(map: "outbox_messages_idempotency_key_key") @map("idempotency_key") @db.VarChar(200)
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil    DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastError      String?      @map("last_error") @db.VarChar(1000)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt    DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt], map: "outbox_messages_status_next_attempt_at_idx")
  @@map("outbox_messages")
}

enum FilePurpose {
  avatar
  transformation_result

  @@map("file_purpose")
}

// Source of truth for stored objects (12-storage): an object without a row does not exist for
// the app. Business rows reference files.id, never a key or a URL.
model File {
  id           String      @id @default(uuid(7)) @db.Uuid
  ownerId      String      @map("owner_id") @db.Uuid
  owner        User        @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  purpose      FilePurpose
  key          String      @unique(map: "files_key_key") @db.VarChar(200)
  originalName String?     @map("original_name") @db.VarChar(255)
  mime         String      @db.VarChar(100)
  size         Int
  checksum     String      @db.Char(64)
  expiresAt    DateTime?   @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  photoOf      User?       @relation("UserPhoto")

  @@index([ownerId], map: "files_owner_id_idx")
  @@index([expiresAt], map: "files_expires_at_idx")
  @@map("files")
}
