# App
NODE_ENV=test
APP_PORT=3001
APP_CORS_ORIGINS=http://localhost:3000
APP_TRUST_PROXY=0
APP_JSON_BODY_LIMIT=1mb

# Logging
LOG_LEVEL=warn
LOG_PRETTY=false

# Database
DATABASE_URL=postgresql://app:app@localhost:5432/app_test

# Rate limiting (global default per IP / user)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10000
